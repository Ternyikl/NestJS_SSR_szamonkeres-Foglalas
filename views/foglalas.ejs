<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</head>

<body>
    <div class="container p-5 my-5 ">
        <div class="row">
            <div class="col-sm-12">
                <h1>
                    <%= title %>
                </h1>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-body bg-mute">
                        <form method="post">
                            <div class="mb-3 mt-3">
                                <label for="nev" class="form-label">Fogalaló neve: </label>
                                <input type="text" class="form-control mw-300" name="nev"
                                    value="<%= locals.body?.nev %>">
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email cím: </label>
                                <input type="text" class="form-control mw-300" name="email"
                                    value="<%= locals.body?.email%>">
                            </div>
                            <div class="mb-3">
                                <label for="datum" class="form-label">Fogalalás dátuma: </label>
                                <input type="datetime-local" class="form-control mw-300" name="datum"
                                    value="<%= locals.body?.datum %>">
                            </div>
                            <div class="mb-3">
                                <label for="nezok" class="form-label">Foglalni kiván hegyek száma: </label>
                                <input type="number" class="form-control mw-300" name="nezok" min="1"
                                    value="<%= locals.body?.nezok %>">
                            </div>

                            <% if (locals.errors && locals.errors.length> 0) { %>
                                <% locals.errors.forEach(e=> { %>
                                    <div class="alert alert-danger mb-1">
                                        <strong>
                                            <%= e %>
                                        </strong>
                                    </div>
                                    <% }) %>
                                <% } %>

                                <button type="submit" class="btn btn-secondary mb-3">Foglalás</button>

                                <% if (locals.success) { %>
                                    <div class="alert alert-success">
                                        <strong>Sikeres feltöltés!</strong>
                                    </div>
                                <% } %>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>